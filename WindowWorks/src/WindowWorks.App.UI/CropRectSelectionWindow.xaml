<Window x:Class="WindowWorks.App.UI.CropRectSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="#01000000" Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize" ShowActivated="True" Cursor="Cross"
        Loaded="OnLoaded" KeyDown="OnKeyDown"
        MouseLeftButtonDown="OnMouseLeftButtonDown" MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseLeftButtonUp">
    <Canvas x:Name="RootCanvas">
        <!-- Dimming scrim over the whole target rect, punched out visually by the selection rect
             below (the scrim itself is a single translucent fill; the "punch out" is achieved by
             simply drawing the selection border/handles on top, matching the picker's existing
             yellow-box visual language rather than a true clip-based cutout). -->
        <Rectangle x:Name="Scrim" Fill="#66000000" IsHitTestVisible="False" />

        <Border x:Name="SelectionBorder" BorderBrush="#FFFFFF00" BorderThickness="2" Background="#22FFFF00"
                Visibility="Collapsed" IsHitTestVisible="False" SnapsToDevicePixels="True" UseLayoutRounding="True" />

        <TextBlock x:Name="HintText" Foreground="White" FontSize="13" FontWeight="SemiBold"
                   Background="#AA222222" Padding="8,4" IsHitTestVisible="False"
                   Text="Drag to select the region to crop and reparent. Enter to confirm, Esc to cancel." />
    </Canvas>
</Window>
