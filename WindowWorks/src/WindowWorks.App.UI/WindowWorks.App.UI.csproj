<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageIcon>appicon.png</PackageIcon>
    <ApplicationIcon>appicon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="appicon.ico" />
    <!-- appicon.png used by WPF resources: mark as Resource so LoadComponent can load it via pack URI -->
    <Resource Include="appicon.png" />
  </ItemGroup>
  <ItemGroup>
    <!-- Reference System.Windows.Forms for ColorDialog used in WPF settings control -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>
  <!-- Remove explicit None/Pack entry for appicon.png; packed resources are handled by the Resource item above. -->

</Project>
