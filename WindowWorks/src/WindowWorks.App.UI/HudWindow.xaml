<Window x:Class="WindowWorks.App.UI.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight" Opacity="0.92" ResizeMode="NoResize">
    <Border Background="#88000000" CornerRadius="6" Padding="8">
        <Grid VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="MessageText" Foreground="White" FontSize="13" VerticalAlignment="Center" Text="Opacity +5%" Grid.Column="0" />

                <!-- Progress with percent overlay -->
                <Grid Grid.Column="2" Height="12" VerticalAlignment="Center">
                    <ProgressBar x:Name="OpacityBar" Minimum="0" Maximum="100" Height="12" Value="100" />
                    <TextBlock x:Name="PercentText" Foreground="White" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Text="100%" />
                </Grid>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="ResetButton" Width="64" Height="22" Content="Reset" Margin="0,0,8,0" />
                <Button x:Name="UndoButton" Width="64" Height="22" Content="Undo" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
