<Window x:Class="WindowWorks.App.UI.ReparentHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowWorks - Reparented Window"
        Width="800" Height="600"
        WindowStyle="None"
        ResizeMode="NoResize"
        Loaded="OnLoaded" Closing="OnClosing">
    <Grid>
        <Border x:Name="SocketHost" Background="White" />
        <Border x:Name="OriginalTemporarilyReopenedNotice" Background="#CC1E1E1E" Visibility="Collapsed">
            <TextBlock Text="Original temporarily reopened for picking"
                       Foreground="White"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center" />
        </Border>
    </Grid>
</Window>
