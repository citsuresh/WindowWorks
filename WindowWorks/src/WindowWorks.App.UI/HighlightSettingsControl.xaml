<UserControl x:Class="WindowWorks.App.UI.HighlightSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="420" Width="520">
    <StackPanel Margin="12">
        <TextBlock FontSize="16" FontWeight="Bold">Highlight &amp; HUD</TextBlock>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Width="140">Border color (hex)</TextBlock>
            <TextBox x:Name="TxtBorderColor" Width="200" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Width="140">Border thickness (px)</TextBlock>
            <TextBox x:Name="TxtBorderThickness" Width="60" />
            <TextBlock Width="20" />
            <TextBlock Width="140">Corner radius (px)</TextBlock>
            <TextBox x:Name="TxtCornerRadius" Width="60" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Width="140">Highlight duration (ms)</TextBlock>
            <TextBox x:Name="TxtHighlightMs" Width="100" />
            <TextBlock Width="20" />
            <TextBlock Width="140">HUD duration (ms)</TextBlock>
            <TextBox x:Name="TxtHudMs" Width="100" />
        </StackPanel>
        <CheckBox x:Name="ChkUseSystemColors" Content="Use system accent colors" Margin="0,8,0,0" />
    </StackPanel>
</UserControl>
