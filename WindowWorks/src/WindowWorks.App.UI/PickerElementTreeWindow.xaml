<Window x:Class="WindowWorks.App.UI.PickerElementTreeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WindowWorks.App.UI"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip" ShowActivated="True" Width="340" Height="420" MinWidth="260" MinHeight="200" Loaded="OnLoaded">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border Background="#EE2B2B2B" BorderBrush="#CCFFB74D" BorderThickness="1" CornerRadius="3" Padding="4">
        <DockPanel LastChildFill="True">
            <Grid DockPanel.Dock="Top" Margin="4,2,4,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="View Element Tree" Foreground="#FFFFB74D" FontSize="13"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="RefreshButton" Width="26" Height="26" Padding="0"
                            Background="Transparent" BorderBrush="#55FFFFFF" BorderThickness="1"
                            Foreground="White" Focusable="False" ToolTip="Refresh" Click="OnRefreshClick">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="CloseButton" Width="26" Height="26" Padding="0" Margin="4,0,0,0"
                            Background="Transparent" BorderBrush="#55FFFFFF" BorderThickness="1"
                            Foreground="White" Focusable="False" ToolTip="Close" Click="OnCloseClick">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="4,6,4,2">
                <Button x:Name="SelectButton" Content="Select" Padding="8,4"
                        IsEnabled="False" Click="OnSelectClick" />
            </StackPanel>
            <TreeView x:Name="Tree" Background="Transparent" BorderThickness="0"
                      SelectedItemChanged="OnSelectedItemChanged">
                <TreeView.Resources>
                    <!-- Explicit selected-row colors: without these, TreeViewItem falls back to
                         the system highlight brush, which on this dark background rendered with
                         the same near-white foreground as unselected rows, making the "current"
                         row indistinguishable except by a thin dotted focus rect. -->
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FFFFB74D" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FF1E1E1E" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FFFFB74D" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FF1E1E1E" />
                    <Style TargetType="{x:Type TreeViewItem}">
                        <EventSetter Event="Expanded" Handler="OnItemExpanded" />
                        <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick" />
                    </Style>
                </TreeView.Resources>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Label}" ToolTip="{Binding FullLabel}" Foreground="White"
                                   FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </DockPanel>
    </Border>
</Window>
