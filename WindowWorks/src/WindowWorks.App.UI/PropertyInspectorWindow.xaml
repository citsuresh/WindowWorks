<Window x:Class="WindowWorks.App.UI.PropertyInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inspect UI Element"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip" ShowActivated="True" Width="560" Height="360" MinWidth="420" MinHeight="220">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border Background="#EE2B2B2B" BorderBrush="#CCFFB74D" BorderThickness="1" CornerRadius="3" Padding="4">
        <DockPanel LastChildFill="True">
            <Grid DockPanel.Dock="Top" Margin="4,2,4,6" Background="Transparent" Cursor="SizeAll"
                  MouseLeftButtonDown="OnDragHandleMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Inspect UI Element" Foreground="#FFFFB74D" FontSize="13"
                           FontWeight="SemiBold" VerticalAlignment="Center" IsHitTestVisible="True" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CloseButton" Width="26" Height="26" Padding="0"
                            Background="Transparent" BorderBrush="#55FFFFFF" BorderThickness="1"
                            Foreground="White" Focusable="False" ToolTip="Close" Click="OnCloseClick">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
            <DataGrid ItemsSource="{Binding Properties}"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      Background="Transparent"
                      Foreground="White"
                      BorderThickness="0"
                      RowBackground="Transparent"
                      AlternatingRowBackground="#221E1E1E"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#33FFFFFF"
                      HeadersVisibility="Column">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FFFFB74D" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FF1E1E1E" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FFFFB74D" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FF1E1E1E" />
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#331E1E1E" />
                        <Setter Property="Foreground" Value="#FFFFB74D" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="BorderBrush" Value="#55FFFFFF" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="Padding" Value="6,4" />
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="6,3" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FFFFB74D" />
                                <Setter Property="Foreground" Value="#FF1E1E1E" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Property" Binding="{Binding Name}" Width="190" />
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</Window>
