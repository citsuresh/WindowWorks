<Window x:Class="WindowWorks.App.UI.PickerBoxListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WindowWorks.App.UI"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize" ShowActivated="False" SizeToContent="Height" Width="300" Loaded="OnLoaded">
    <Window.Resources>
        <local:IndentLevelToMarginConverter x:Key="IndentLevelToMarginConverter" />
    </Window.Resources>
    <Border Background="#E63C3C3C" BorderBrush="#CCFFFF00" BorderThickness="1" CornerRadius="3" Padding="2">
        <DockPanel LastChildFill="True">
            <Grid DockPanel.Dock="Top" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="OnDragHandleMouseLeftButtonDown" Margin="4,2,2,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Select Element" Foreground="#FFFFFF00" FontSize="12"
                           FontWeight="SemiBold" VerticalAlignment="Center" IsHitTestVisible="False" />
            <Button x:Name="CloseButton" Grid.Column="1" HorizontalAlignment="Right" Width="22" Height="22"
                    Padding="0" Margin="0,0,0,2" Background="Transparent" BorderBrush="#55FFFFFF" BorderThickness="1"
                    Foreground="White" Focusable="False" ToolTip="Close" Click="OnCloseClick">
                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            </Grid>
            <ItemsControl x:Name="BoxList" HorizontalContentAlignment="Stretch">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="BoxBorder" HorizontalAlignment="Stretch"
                            Margin="{Binding IndentLevel, Converter={StaticResource IndentLevelToMarginConverter}}"
                            Padding="6,4" CornerRadius="2" Background="#CCFFFF00" Opacity="0.5"
                            ToolTip="{Binding FullLabel}"
                            MouseEnter="OnBoxMouseEnter" MouseLeftButtonUp="OnBoxClick" Tag="{Binding}">
                        <DockPanel LastChildFill="True">
                            <Path x:Name="ReparentIcon" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"
                                  DockPanel.Dock="Left"
                                  Stretch="Uniform" Stroke="Black" StrokeThickness="1.6" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M0,10 L10,0 M4,0 L10,0 L10,6" />
                            <Path x:Name="CropIcon" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"
                                  DockPanel.Dock="Left"
                                  Stretch="Uniform" Stroke="Black" StrokeThickness="1.6" Visibility="Collapsed"
                                  Data="M2,0 L2,8 L10,8 M4,2 L12,2 L12,10" />
                            <Path x:Name="TreeIcon" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"
                                  DockPanel.Dock="Left"
                                  Stretch="Uniform" Stroke="Black" StrokeThickness="1.4" Visibility="Collapsed"
                                  Data="M2,1 L2,11 M2,3 L8,3 M2,6 L8,6 M2,9 L8,9" />
                            <TextBlock Text="{Binding FullLabel}" Foreground="Black" FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsCropEntry}" Value="True">
                            <Setter TargetName="BoxBorder" Property="Background" Value="#CC33C4FF" />
                            <Setter TargetName="CropIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ReparentIcon" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsElementTreeEntry}" Value="True">
                            <Setter TargetName="BoxBorder" Property="Background" Value="#CCFFB74D" />
                            <Setter TargetName="TreeIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ReparentIcon" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <Trigger SourceName="BoxBorder" Property="IsMouseOver" Value="True">
                            <Setter TargetName="BoxBorder" Property="Opacity" Value="1" />
                        </Trigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Window>
