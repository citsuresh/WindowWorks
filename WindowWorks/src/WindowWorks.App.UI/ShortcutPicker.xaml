<UserControl x:Class="WindowWorks.App.UI.ShortcutPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="40" Width="300">
    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="4">
        <TextBox x:Name="ShortcutTextBox" IsReadOnly="True" VerticalAlignment="Center" HorizontalAlignment="Stretch" PreviewKeyDown="OnPreviewKeyDown"/>
    </Border>
</UserControl>