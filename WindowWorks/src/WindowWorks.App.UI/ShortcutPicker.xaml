<UserControl x:Class="WindowWorks.App.UI.ShortcutPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="40" Width="300">
    <StackPanel>
        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="4">
            <TextBox x:Name="ShortcutTextBox" Text="{Binding Shortcut, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" VerticalAlignment="Center" HorizontalAlignment="Stretch" PreviewKeyDown="OnPreviewKeyDown"/>
        </Border>
        <TextBlock x:Name="WarningText" Text="" Foreground="Red" Margin="4,6,4,0" Visibility="Collapsed" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>