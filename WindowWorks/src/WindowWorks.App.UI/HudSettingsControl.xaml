<UserControl x:Class="WindowWorks.App.UI.HudSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="260" Width="520">
    <StackPanel Margin="12">
        <TextBlock FontSize="16" FontWeight="Bold">HUD</TextBlock>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Width="220">Background color</TextBlock>
            <TextBox x:Name="TxtHudBackground" Width="220" />
            <Button x:Name="BtnPickColor" Content="..." Width="28" Margin="6,0,0,0" Click="BtnPickColor_Click" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Width="220">Transparency (%)</TextBlock>
            <TextBox x:Name="TxtTransparency" Width="60" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Width="220">Font size</TextBlock>
            <TextBox x:Name="TxtHudFontSize" Width="60" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Width="220">Corner radius</TextBlock>
            <TextBox x:Name="TxtHudCorner" Width="60" />
        </StackPanel>

        <TextBlock FontWeight="SemiBold" Margin="0,12,0,0">Show HUD for</TextBlock>
        <CheckBox x:Name="ChkOpacityHud" Content="Opacity changes" Margin="0,6,0,0" />
        <CheckBox x:Name="ChkTopmostHud" Content="Topmost toggles" Margin="0,6,0,0" />
        <CheckBox x:Name="ChkPresetHud" Content="Preset applied" Margin="0,6,0,0" />
    </StackPanel>
</UserControl>