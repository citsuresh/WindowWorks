
    <UserControl x:Class="WindowWorks.App.UI.HudSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="450" Width="550">
    <StackPanel Margin="12">
        <TextBlock FontSize="16" FontWeight="Bold">HUD settings</TextBlock>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Width="220">Background color</TextBlock>
            <TextBox x:Name="TxtHudBackground" Width="180" Text="{Binding BackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="TxtHudBackground_TextChanged" />
            <Button x:Name="BtnPickColor" Content="Choose..." Width="74" Margin="6,0,0,0" Click="BtnPickColor_Click" />
            <Rectangle x:Name="RectHudPreview" Width="28" Height="20" Stroke="Gray" StrokeThickness="1" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
            <TextBlock Width="220">Transparency (%)</TextBlock>
            <Slider x:Name="SldTransparency" Width="214" Minimum="0" Maximum="100" Value="{Binding TransparencyPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock x:Name="TxtTransparencyValue" Width="40" TextAlignment="Center" Margin="6,0,0,0" Text="{Binding TransparencyPercent}" />
            <Rectangle x:Name="RectHudPreviewWithAlpha" Width="28" Height="20" Stroke="Gray" StrokeThickness="1" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Width="220">Font size</TextBlock>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="TxtHudFontSize" Width="60" Text="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="TxtHudFontSize_TextChanged" PreviewMouseWheel="NumericBox_PreviewMouseWheel" />
                <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                    <RepeatButton x:Name="BtnHudFontUp" Content="+" Width="24" Height="20" Delay="200" Interval="80" Click="BtnHudFontUp_Click" />
                    <RepeatButton x:Name="BtnHudFontDown" Content="-" Width="24" Height="20" Margin="6,0,0,0" Delay="200" Interval="80" Click="BtnHudFontDown_Click" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Width="220">HUD duration (ms)</TextBlock>
            <TextBox x:Name="TxtHudDuration" Width="120" Text="{Binding DurationMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="TxtHudDuration_TextChanged" PreviewMouseWheel="NumericBox_PreviewMouseWheel" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Width="220">Corner radius</TextBlock>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="TxtHudCorner" Width="60" Text="{Binding CornerRadius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="TxtHudCorner_TextChanged" PreviewMouseWheel="NumericBox_PreviewMouseWheel" />
                <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                    <RepeatButton x:Name="BtnHudCornerUp" Content="+" Width="24" Height="20" Delay="200" Interval="80" Click="BtnHudCornerUp_Click" />
                    <RepeatButton x:Name="BtnHudCornerDown" Content="-" Width="24" Height="20" Margin="6,0,0,0" Delay="200" Interval="80" Click="BtnHudCornerDown_Click" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <TextBlock FontWeight="SemiBold" Margin="0,12,0,0">Show HUD for</TextBlock>
        <CheckBox x:Name="ChkOpacityHud" Content="Opacity changes" Margin="0,6,0,0" IsChecked="{Binding ShowOnOpacityChange, Mode=TwoWay}" />
        <CheckBox x:Name="ChkTopmostHud" Content="Topmost toggles" Margin="0,6,0,0" IsChecked="{Binding ShowOnTopmostToggle, Mode=TwoWay}" />
        <CheckBox x:Name="ChkPresetHud" Content="Preset applied" Margin="0,6,0,0" IsChecked="{Binding ShowOnPresetApplied, Mode=TwoWay}" />

        <TextBlock FontWeight="SemiBold" Margin="0,12,0,0">Show HUD for Click-Through</TextBlock>
        <CheckBox x:Name="ChkGestureHud" Content="Click-Through gesture (Ctrl+Alt+Click)" Margin="0,6,0,0" IsChecked="{Binding ShowOnClickThroughGesture, Mode=TwoWay}" />
        <CheckBox x:Name="ChkModifierHud" Content="Click-Through modifier (Ctrl+Alt+Shift held)" Margin="0,6,0,0" IsChecked="{Binding ShowOnClickThroughModifier, Mode=TwoWay}" />

        <!-- Embedded HUD preview (small live sample shown below settings) -->
        <Border x:Name="PreviewBorder" Width="360" Height="80" CornerRadius="6" Margin="0,12,0,0" HorizontalAlignment="Left" Background="#00FFFFFF" BorderBrush="#888888" BorderThickness="1">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="22" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="PreviewMessage" Grid.Row="0" Text="HUD Preview" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Foreground="Black" />
                <ProgressBar x:Name="PreviewProgress" Grid.Row="1" Height="10" Minimum="0" Maximum="100" Value="75" Margin="0,6,0,0" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>