{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WindowWorks Preset",
  "type": "object",
  "properties": {
    "Name": { "type": "string" },
    "Description": { "type": ["string", "null"] },
    "Opacity": { "type": "integer", "minimum": 0, "maximum": 100 },
    "Topmost": { "type": "boolean" },
    "ClickThrough": { "type": "boolean" }
  },
  "required": ["Name", "Opacity", "Topmost", "ClickThrough"]
}
